#!/bin/sh
# Convert the approved artwork to the standard macOS icon representations.
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$#" -ne 1 ]; then
  echo 'Usage: bin/build-app-icon OUTPUT.icns' >&2
  exit 2
fi
task_output=$1
task_temp=$(mktemp -d "${TMPDIR:-/tmp}/codex-app-icon.XXXXXX")
trap 'rm -rf "$task_temp"' EXIT
task_iconset="$task_temp/AppIcon.iconset"
mkdir -p "$task_iconset" "$(dirname -- "$task_output")"
for task_size in 16 32 128 256 512; do
  sips -z "$task_size" "$task_size" "$task_root/macos/Assets/AppIcon.png" \
    --out "$task_iconset/icon_${task_size}x${task_size}.png" >/dev/null
  task_retina=$((task_size * 2))
  sips -z "$task_retina" "$task_retina" "$task_root/macos/Assets/AppIcon.png" \
    --out "$task_iconset/icon_${task_size}x${task_size}@2x.png" >/dev/null
done
iconutil -c icns "$task_iconset" -o "$task_output"
